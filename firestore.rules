rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Bug analysis jobs are created and written exclusively by the backend
    // (the Admin SDK bypasses these rules). Clients only ever READ a single
    // job by its unguessable random ID. Listing the whole collection is denied
    // so one client can't enumerate other users' jobs.
    match /bugJobs/{jobId} {
      allow get: if true;
      allow list, write: if false;

      // Proposed changes for a job. The client lists them once the job is done.
      match /proposals/{proposalId} {
        allow get, list: if true;
        allow write: if false;
      }
    }

    // Everything else is locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
